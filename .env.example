# Database Configuration
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql+asyncpg://dashboard:your_secure_postgres_password_here@db:5432/dashboard

# Application Secrets (REQUIRED: Generate 32-byte Base64 key for MASTER_KEY)
# Example generation: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=ReplaceWithBase64Encoded32ByteMasterKey=
JWT_SECRET=ReplaceWithSecureRandomJWTSecretKey

# JWT Lifetime Settings
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# CORS & Server Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
RATE_LIMIT_LOGIN_PER_MINUTE=5
EXPOSE_OPENAPI_DOCS=true
LOG_LEVEL=INFO

# Metrics & Background Poller
POLLER_INTERVAL_SECONDS=30
POLLER_TIMEOUT_SECONDS=10
POLLER_ENABLED=true
METRICS_RETENTION_DAYS=7

# Ansible Deployment Timeout
PLAYBOOK_PATH=/playbook
DEPLOY_TIMEOUT_SECONDS=1800

# Alerts & Slack Integration (Optional)
ALERT_DEBOUNCE_MINUTES=15
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
