# MongoDB Standalone Configuration with Auth (no replication, no keyFile)
storage:
  dbPath: {{ dbPath }}

systemLog:
  destination: file
  logAppend: true
  path: {{ logpath }}
  logRotate: reopen
  verbosity: 1

net:
  port: {{ mongodb_port }}
  bindIp: 127.0.0.1,{{ vm_ip }}
  maxIncomingConnections: 1000

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

security:
  authorization: enabled
  javascriptEnabled: false

operationProfiling:
  mode: slowOp
  slowOpThresholdMs: 100
