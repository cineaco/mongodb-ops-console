# MongoDB Configuration with Replication (NO Authorization)
# where and how to store data.
storage:
  dbPath: {{ dbPath }}
#  wiredTiger:
#    engineConfig:
#      cacheSizeGB: 1  # Adjust based on available RAM

# where to write logging data.
systemLog:
  destination: file
  logAppend: true
  path: {{ logpath }}
  verbosity: 1

# network interfaces
net:
  port: {{ mongodb_port }}
  bindIp: 127.0.0.1,{{ vm_ip }}
  maxIncomingConnections: 1000

# how the process runs
processManagement:
  timeZoneInfo: /usr/share/zoneinfo
  #pidFilePath: {{ pidFilePath }}

# security configuration
security:
  #keyFile: {{ keyFile }}  # Disabled for replicaset initialization
  javascriptEnabled: false  # Disable server-side JavaScript for security
  # authorization: disabled  # Comment out for replicaset initialization

# operation profiling for performance monitoring
operationProfiling:
  mode: slowOp
  slowOpThresholdMs: 100

# replica set configuration
replication:
  replSetName: {{ replicaset_name }}
  oplogSizeMB: {{ oplogSizeMB }}  # Adjust based on requirements
